#include <stdio.h>
#include <string.h>

#define TAM 9
#define INFINITO 999999999

typedef struct {
    int origem;
    int destino;
    int peso;
} ARESTA;

ARESTA arestas[350];

int Cavalo(int n_arestas, int n_no, int origem, int destino)
{
    int i, j, trocou = 1;
    int distancia[65];

    for (i = 0; i <= n_no; i++)
    {
        distancia[i] = INFINITO;
    }

    distancia[origem] = 0;

    for (i = 0; i <= n_no && trocou; i++)
    {
        trocou = 0;
        for (j = 0; j < n_arestas; j++)
        {
            if (distancia[arestas[j].destino] > distancia[arestas[j].origem] + arestas[j].peso)
            {
                distancia[arestas[j].destino] = distancia[arestas[j].origem] + arestas[j].peso;
                trocou = 1;
            }
        }
    }
    return distancia[destino];
}

int main()
{
    int tabuleiro[TAM][TAM];

    int aux = 1;
    int i, j;
    for (i = 1; i < TAM; i++)
    {
        for (j = 1; j < TAM; j++)
        {
            tabuleiro[i][j] = aux++;
        }
    }

    aux = 0;
    for (i = 1; i < TAM; i++)
    {
        for (j = 1; j < TAM; j++)
        {
            if ((i + 1) < TAM && (j + 2) < TAM)
            {
                arestas[aux].origem = tabuleiro[i][j];
                arestas[aux].destino = tabuleiro[i + 1][j + 2];
                arestas[aux].peso = 1;
                aux++;
            }
            if ((i + 1) < TAM && (j - 2) >= 1)
            {
                arestas[aux].origem = tabuleiro[i][j];
                arestas[aux].destino = tabuleiro[i + 1][j - 2];
                arestas[aux].peso = 1;
                aux++;
            }
            if ((i + 2) < TAM && (j + 1) < TAM)
            {
                arestas[aux].origem = tabuleiro[i][j];
                arestas[aux].destino = tabuleiro[i + 2][j + 1];
                arestas[aux].peso = 1;
                aux++;
            }
            if ((i + 2) < TAM && (j - 1) >= 1)
            {
                arestas[aux].origem = tabuleiro[i][j];
                arestas[aux].destino = tabuleiro[i + 2][j - 1];
                arestas[aux].peso = 1;
                aux++;
            }
            if ((i - 1) > 0 && (j + 2) < TAM)
            {
                arestas[aux].origem = tabuleiro[i][j];
                arestas[aux].destino = tabuleiro[i - 1][j + 2];
                arestas[aux].peso = 1;
                aux++;
            }
            if ((i - 1) > 0 && (j - 2) >= 1)
            {
                arestas[aux].origem = tabuleiro[i][j];
                arestas[aux].destino = tabuleiro[i - 1][j - 2];
                arestas[aux].peso = 1;
                aux++;
            }
            if ((i - 2) > 0 && (j + 1) < TAM)
            {
                arestas[aux].origem = tabuleiro[i][j];
                arestas[aux].destino = tabuleiro[i - 2][j + 1];
                arestas[aux].peso = 1;
                aux++;
            }
            if ((i - 2) > 0 && (j - 1) >= 1)
            {
                arestas[aux].origem = tabuleiro[i][j];
                arestas[aux].destino = tabuleiro[i - 2][j - 1];
                arestas[aux].peso = 1;
                aux++;
            }
        }
    }

    int origem, destino;
    char de[3], para[3];

    while (scanf("%s %s", de, para) == 2)
    {
        origem = (de[0] - 'a') * 8 + de[1] - '0';
        destino = (para[0] - 'a') * 8 + para[1] - '0';

        printf("To get from %s to %s takes %d knight moves.\n", de, para, Cavalo(aux, 64, origem, destino));

        if (strcmp(de, para) == 0)
        {
            break;
        }
    }

    return 0;
}
