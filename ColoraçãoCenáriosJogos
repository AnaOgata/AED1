#include <stdio.h>
#include <string.h>
#include <stdbool.h>

#define MAX 1040
#define TAMANHO_FILA (MAX * MAX)

char grafo[MAX][MAX];

typedef struct {
    int x, y;
} Vertice;

Vertice filaDeVertices[TAMANHO_FILA];
int inicioFila = 0, fimFila = 0;

void enfileirar(int x, int y)
{
    if (fimFila < TAMANHO_FILA)
    {
        filaDeVertices[fimFila++] = (Vertice){x, y};
    }
}

Vertice desenfileirar()
{
    return filaDeVertices[inicioFila++];
}

bool filaVazia()
{
    return inicioFila == fimFila;
}

void buscarEmLargura(int verticeInicialX, int verticeInicialY)
{
    enfileirar(verticeInicialX, verticeInicialY);
    grafo[verticeInicialX][verticeInicialY] = 'o';

    int adjacencias[4][2] = {{1, 0}, {-1, 0}, {0, 1}, {0, -1}};

    while (!filaVazia())
    {
        Vertice verticeAtual = desenfileirar();
        int x = verticeAtual.x;
        int y = verticeAtual.y;

        for (int i = 0; i < 4; i++)
        {
            int novoX = x + adjacencias[i][0];
            int novoY = y + adjacencias[i][1];

            if (novoX >= 1 && novoX < MAX && novoY >= 1 && novoY < MAX && grafo[novoX][novoY] == '.')
            {
                grafo[novoX][novoY] = 'o';
                enfileirar(novoX, novoY);
            }
        }
    }
}

int main()
{
    int numeroDeLinhas, numeroDeColunas, componentesConexos = 0;
    scanf("%d %d", &numeroDeLinhas, &numeroDeColunas);
    memset(grafo, '0', sizeof grafo);

    for (int i = 1; i <= numeroDeLinhas; i++)
    {
        scanf("%s", &grafo[i][1]);
    }

    for (int i = 1; i <= numeroDeLinhas; i++)
    {
        for (int j = 1; j <= numeroDeColunas; j++)
        {
            if (grafo[i][j] == '.')
            {
                buscarEmLargura(i, j);
                componentesConexos++;
            }
        }
    }

    printf("%d\n", componentesConexos);
    return 0;
}
